{
  "method": "kairos",
  "runtime_profile": "kairos",
  "command": [
    "${PYTHON}",
    "-m",
    "vllm.entrypoints.openai.api_server",
    "--model",
    "${MODEL}",
    "--served-model-name",
    "${MODEL}",
    "--host",
    "127.0.0.1",
    "--port",
    "18765",
    "--max-model-len",
    "16384",
    "--max-num-seqs",
    "8",
    "--max-num-batched-tokens",
    "2048",
    "--block-size",
    "16",
    "--gpu-memory-utilization",
    "0.9",
    "--enable-prefix-caching",
    "--generation-config",
    "vllm",
    "--seed",
    "1",
    "--no-enable-log-requests",
    "--safetensors-load-strategy",
    "eager",
    "--dtype",
    "bfloat16",
    "--attention-config",
    "{\"backend\": \"FLASH_ATTN\", \"flash_attn_version\": 2}",
    "--compilation-config",
    "{\"mode\": 0, \"cudagraph_mode\": \"FULL_DECODE_ONLY\", \"cudagraph_capture_sizes\": [1, 2, 4, 8], \"cudagraph_num_of_warmups\": 2}",
    "--worker-cls",
    "kairos._runtime.layout.worker.DiagnosticWorker",
    "--async-scheduling",
    "--scheduler-cls",
    "kairos.scheduler.KairosScheduler",
    "--scheduling-policy",
    "priority",
    "--kv-transfer-config",
    "{\"kv_connector\": \"GappedConnector\", \"kv_role\": \"kv_both\", \"kv_connector_extra_config\": {\"lmcache.mp.host\": \"tcp://127.0.0.1\", \"lmcache.mp.port\": 18766, \"lmcache.mp.lazy_offload\": true}, \"kv_connector_module_path\": \"kairos._runtime.layout.connector\"}",
    "--disable-hybrid-kv-cache-manager"
  ],
  "environment": {
    "HF_HUB_OFFLINE": "1",
    "HF_HUB_DISABLE_XET": "1",
    "VLLM_USE_V2_MODEL_RUNNER": "0",
    "HF_ENDPOINT": "https://hf-mirror.com",
    "CONTINUUM_LOG_TIMING": "1",
    "CONTINUUM_GAPPED_COALESCE": "1",
    "CONTINUUM_GAPPED_ADOPT_LOAD_HITS": "1",
    "CONTINUUM_PCV_DEFER_PUBLICATION": "1",
    "CONTINUUM_GAPPED_QUERY_BUDGET": "1",
    "CONTINUUM_PCV_USE_AUDIT": "1",
    "CONTINUUM_GAPPED_ADAPTIVE_THRESHOLD": "1",
    "CONTINUUM_GAPPED_ADAPTIVE_TOKENS": "512",
    "CONTINUUM_GAPPED_SKIP_IMPOSSIBLE_PLAN": "1",
    "CONTINUUM_ASYNC_CAPACITY_FENCE": "1",
    "CONTINUUM_EXPECTED_SCHEDULER": "kairos.scheduler.KairosScheduler",
    "CONTINUUM_ASYNC_PREFIX_EXECUTION": "1",
    "CONTINUUM_PREFIX_ONLY_CORRECTNESS": "1",
    "CONTINUUM_ONLINE_PATH_PRIOR": "${ROOT}/assets/program_prior.json",
    "CONTINUUM_ONLINE_PATH_NATIVE": "1",
    "CONTINUUM_MODEL": "${MODEL}",
    "CONTINUUM_WORK_MESSAGES": "${ROOT}/data/workload/visible_messages.json",
    "CONTINUUM_LOG_PATH": "${OUT}/scheduler.jsonl",
    "CONTINUUM_TTL_MODE": "paper",
    "CONTINUUM_TTL_SECONDS": "2",
    "CONTINUUM_SEARCH_BUDGET_MS": "10",
    "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
    "VLLM_USE_FLASHINFER_SAMPLER": "0",
    "VLLM_SERVER_DEV_MODE": "1",
    "LMCACHE_LOCAL_CPU": "True",
    "LMCACHE_MAX_LOCAL_CPU_SIZE": "8.0",
    "LMCACHE_CHUNK_SIZE": "256",
    "LMCACHE_SAVE_DECODE_CACHE": "False",
    "LMCACHE_ENABLE_ASYNC_LOADING": "False",
    "CONTINUUM_PROFILE": "${PROFILE}",
    "CONTINUUM_DECODE_PROFILE_PATH": "${OUT}/inactive_decode_profile.json",
    "CONTINUUM_GAPPED_REUSE": "1",
    "CONTINUUM_GAPPED_MODEL_ID": "${MODEL}",
    "CONTINUUM_LMCACHE_CPU_GB": "8.0",
    "CONTINUUM_GAPPED_FIXTURE": "1",
    "CONTINUUM_GAPPED_WORKER_LOG": "${OUT}/gapped-worker.jsonl",
    "CONTINUUM_PCV_CONTROL": "1",
    "CONTINUUM_TRANSFER_LOG": "${OUT}/transfers.jsonl",
    "CONTINUUM_RELOAD_PROFILE": "${RELOAD}",
    "CONTINUUM_REPLICA_SOCKET": "${SOCKET}",
    "CONTINUUM_REPLICA_LOG": "${OUT}/replicas.jsonl",
    "CONTINUUM_REPLICA_MODE": "observe"
  },
  "engine_affinity": "4-5,68-69",
  "helper_affinity": "6-7,70-71",
  "cpu_kv_gib": 8,
  "prewarm_trace": false,
  "gpu_auto_kv": true
}
